<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CShapeSerialPort</RootNamespace>
    <AssemblyName>CShapeSerialPort</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>1_vspdconfig.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyTitle>CShapeSerialPort</AssemblyTitle>
    <Product>CShapeSerialPort</Product>
    <Copyright>Copyright © 2012</Copyright>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainFrom.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainFrom.Designer.cs">
      <DependentUpon>MainFrom.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainFrom.resx">
      <DependentUpon>MainFrom.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
